{
  "name": "basteyy/plates-url-toolset",
  "description": "URL helper functions (links, absolute urls, named urls, cache busting) for the Plates template engine",
  "type": "library",
  "keywords": [
    "plates",
    "league",
    "template",
    "url",
    "link",
    "extension"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "basteyy",
      "email": "sebastian@xzit.email"
    }
  ],
  "autoload": {
    "psr-4": {
      "basteyy\\PlatesUrlToolset\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "basteyy\\PlatesUrlToolset\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
    "league/plates": "v3.6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
